# ┌─────────────────────────────────────────────────────────────────┐
# │  ghostty · hacker terminal config                                 │
# │  Targets Ghostty 1.3+. Install with ./install.sh, or copy this    │
# │  file to ~/.config/ghostty/config and themes/ to                  │
# │  ~/.config/ghostty/themes/.                                       │
# └─────────────────────────────────────────────────────────────────┘

# ── Theme ────────────────────────────────────────────────────────────
# Colors live in themes/ so switching is one line. Options:
#   cyberpunk-neon   neon magenta + cyan on indigo-black (default)
#   matrix-phosphor  phosphor green on green-black
theme = cyberpunk-neon

# Never draw text the same color as its background (e.g. a TUI that sets
# fg = bg). 1.1 only kicks in for invisible text; it won't repaint the theme.
minimum-contrast = 1.1

# Bold text uses the bright palette variant: punchier neon headings.
bold-color = bright

# ── Cursor ───────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = true

# ── Shell integration ────────────────────────────────────────────────
# `no-cursor` matters: by default shell integration turns the cursor into
# a bar at the prompt, which silently overrides the block cursor above.
# ssh-env / ssh-terminfo stop "unknown terminal xterm-ghostty" on remote
# hosts; sudo keeps terminfo working under sudo.
shell-integration = detect
shell-integration-features = no-cursor,sudo,ssh-env,ssh-terminfo

# ── Typography ───────────────────────────────────────────────────────
# JetBrains Mono ships bundled with Ghostty, so this always resolves.
# For prompt icons (Starship, p10k) install a Nerd Font and use e.g.
# `font-family = JetBrainsMono Nerd Font`. Add `font-feature = -calt` to
# turn ligatures off.
font-family = JetBrains Mono
font-size = 13
# A little extra line spacing makes dense output much easier to scan.
adjust-cell-height = 8%
# Heavier strokes so thin neon glyphs don't look washed out (macOS only;
# ignored elsewhere).
font-thicken = true

# ── Window ───────────────────────────────────────────────────────────
# Translucent glass. Blur needs macOS or a compositor that supports it
# (KDE Plasma). Elsewhere it is ignored and you just get transparency.
background-opacity = 0.92
background-blur = 20

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
# Padding takes the color of the nearest cell, so full-screen TUIs with
# their own background (htop, lazygit, vim themes) run edge to edge.
window-padding-color = extend
window-theme = dark
window-save-state = always

# Dim inactive splits so the focused pane glows.
unfocused-split-opacity = 0.6

# ── Quality of life ──────────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = clipboard

# ── Drop-down "quick terminal" ───────────────────────────────────────
# Ctrl+` from anywhere slides a terminal down from the top of the screen.
# Global shortcuts work on macOS (grant Accessibility permission) and on
# Linux desktops whose XDG portal supports GlobalShortcuts (GNOME, KDE).
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

# ── Optional: 256-color palette from the theme ───────────────────────
# Derives colors 16–255 from the 16 theme colors, so apps that use the
# 256-color cube (some vim/tmux themes, btop) match the theme too. Off by
# default because a few legacy programs assume the stock xterm cube.
# palette-generate = true

# ── Optional: shaders ────────────────────────────────────────────────
# Shaders stack in the order listed. Both adapt to the active theme.
#   crt-glow.glsl      soft scanlines, bloom in the text color, vignette
#   cursor-trail.glsl  short neon trail when the cursor jumps
# custom-shader = shaders/crt-glow.glsl
# custom-shader = shaders/cursor-trail.glsl

# ── macOS extras (ignored on Linux) ──────────────────────────────────
# macos-titlebar-style = tabs
# macos-option-as-alt = true
